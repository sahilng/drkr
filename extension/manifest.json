{
  "manifest_version": 3,
  "name": "Drkr \u2014 Dark Mode for Safari",
  "short_name": "Drkr",
  "version": "0.2.0",
  "description": "Comfortable dark mode for the web. Follow your system, or choose per website. No tracking.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Drkr",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "settings.js",
        "colors.js",
        "site-rules.js",
        "content.js"
      ],
      "css": [
        "startup.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "homepage_url": "https://sahilng.github.io/drkr/"
}
