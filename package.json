{
  "name": "drkr",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first dark mode extension for Safari",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser.cjs && node tests/hardening.cjs && node tests/csp.cjs && node tests/contrast.cjs && node tests/lifecycle.cjs",
    "safari": "bash scripts/build-macos.sh",
    "test:site": "node tests/site.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sahilng/drkr.git"
  },
  "homepage": "https://drkr.space/",
  "bugs": {
    "url": "https://github.com/sahilng/drkr/issues"
  }
}
